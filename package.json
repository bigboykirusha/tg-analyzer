{
  "name": "tg-analyzer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "corepack pnpm --filter @tg-analyzer/api dev",
    "dev:web": "corepack pnpm --filter @tg-analyzer/web dev",
    "dev:worker": "corepack pnpm --filter @tg-analyzer/api dev:worker",
    "check": "corepack pnpm -r check",
    "test": "corepack pnpm --filter @tg-analyzer/api test",
    "db:push": "corepack pnpm --filter @tg-analyzer/api db:push",
    "db:migrate": "corepack pnpm --filter @tg-analyzer/api db:migrate",
    "test:integration": "corepack pnpm --filter @tg-analyzer/api test:integration",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools": "3.3.1",
      "@simple-git/argv-parser": "2.0.1",
      "seroval": "1.6.8",
      "shell-quote": "1.12.0",
      "simple-git": "4.0.2",
      "tar": "7.5.22"
    }
  }
}
