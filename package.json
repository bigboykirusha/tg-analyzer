{
  "name": "tg-analyzer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "dev:api": "corepack pnpm --filter @tg-analyzer/api dev",
    "dev:web": "corepack pnpm --filter @tg-analyzer/web dev",
    "dev:worker": "corepack pnpm --filter @tg-analyzer/api dev:worker",
    "check": "corepack pnpm -r check",
    "test": "corepack pnpm --filter @tg-analyzer/shared test && corepack pnpm --filter @tg-analyzer/api test",
    "db:migrate": "corepack pnpm --filter @tg-analyzer/api db:migrate",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "start": "node scripts/start-from-env.mjs",
    "start:api": "corepack pnpm --filter @tg-analyzer/api start",
    "start:web": "corepack pnpm --filter @tg-analyzer/web start",
    "start:worker": "corepack pnpm --filter @tg-analyzer/api worker",
    "test:unit": "corepack pnpm --filter @tg-analyzer/shared test",
    "test:e2e": "corepack pnpm --filter @tg-analyzer/web test:e2e",
    "services:test": "docker compose -f docker-compose.test.yml up -d --wait"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "@nuxt/devtools": "3.3.1",
      "@simple-git/argv-parser": "2.0.1",
      "browserslist": "4.28.7",
      "dompurify": "3.4.16",
      "fflate": "0.8.3",
      "ip-address": "10.7.3",
      "minimatch@3>brace-expansion": "1.1.21",
      "minimatch@10>brace-expansion": "5.0.12",
      "nanoid": "3.3.18",
      "postcss": "8.5.29",
      "seroval": "1.6.8",
      "shell-quote": "1.12.0",
      "simple-git": "4.0.2",
      "source-map-js": "1.2.2",
      "tar": "7.5.22",
      "tsx>esbuild": "0.28.2",
      "ws": "8.21.0",
      "zod": "4.1.5"
    }
  }
}
