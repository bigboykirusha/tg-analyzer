# Production settings. deploy/setup.sh copies this to deploy/.env and fills the secrets.
# Never commit deploy/.env.

# The site's address without https://. Before a domain is bought: the server IP with dashes
# plus .sslip.io (IP 203.0.113.7 → 203-0-113-7.sslip.io). After: the domain, e.g. tganalyzer.com.
SITE_HOST=

# From https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated by setup.sh. Keep them: a new SESSION_ENCRYPTION_KEY signs everyone out of Telegram.
POSTGRES_PASSWORD=
SESSION_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional.
LOG_LEVEL=info
# Analyses a person may start in 24 hours; 0 turns the limit off. Empty = 3.
FREE_ANALYSES_PER_DAY=
# Our bot for «the report is ready» (from @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Alerts to your Telegram when errors pile up or the worker stops (bot token + your chat id).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
