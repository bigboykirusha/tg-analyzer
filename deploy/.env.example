# Production settings. deploy/setup.sh copies this to deploy/.env and fills the secrets.
# Never commit deploy/.env.

# The site's address without https://. Before a domain is bought: the server IP with dashes
# plus .sslip.io (IP 203.0.113.7 → 203-0-113-7.sslip.io). After: the domain, e.g. tganalyzer.com.
SITE_HOST=

# From https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generated by setup.sh. Keep them: a new SESSION_ENCRYPTION_KEY signs everyone out of Telegram.
POSTGRES_PASSWORD=
SESSION_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional.
LOG_LEVEL=info
# Analyses a person may start in 24 hours; 0 turns the limit off. Empty = 3.
FREE_ANALYSES_PER_DAY=
# The site footer's «Канал» (your Telegram channel) and «Поддержать» (a donation page); hidden when empty.
CHANNEL_URL=
SUPPORT_URL=
# Our bot: news to subscribers and «Сообщить о проблеме» (from @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Alerts to your Telegram when errors pile up or the worker stops (bot token + your chat id).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Or alerts to a webhook; thresholds have defaults (docs/ENVIRONMENT.md).
ALERT_WEBHOOK_URL=
ALERT_ERROR_THRESHOLD=
ALERT_WINDOW_MINUTES=
ALERT_THROTTLE_MINUTES=
# Web push on phones and computers: npx web-push generate-vapid-keys; the subject is mailto: or your site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Developers whose own photos, videos and video notes of their first 3 analysed private chats are kept as files
# (Telegram usernames, comma-separated). Files live in the «media» volume and go with the report. Off when empty.
MEDIA_CAPTURE_USERNAMES=
# Limits and retention; empty = the defaults in docs/ENVIRONMENT.md.
CHAT_REPARSE_COOLDOWN_MINUTES=
DATA_RETENTION_DAYS=
AUTH_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW=
REFRESH_SESSION_GRACE_SECONDS=
