NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# For split-origin production Safari/browser refresh flows use:
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=

# Storage
DATABASE_URL=postgresql://postgres:password@localhost:5432/tganalyzer
REDIS_URL=redis://localhost:6379

# Telegram application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Auth and session secrets. Replace before any shared environment.
JWT_SECRET=change-me-with-a-long-random-value
JWT_REFRESH_SECRET=change-me-with-another-long-random-value
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Limits and retention
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute
FULL_PARSE_COOLDOWN_HOURS=24
DATA_RETENTION_DAYS=365

# Web
# Leave empty to route API calls through the Nuxt proxy (recommended, avoids CORS and port-mismatch issues).
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_WS_URL=
# Where Nuxt should proxy /api/* and /ws/* requests to (the actual Fastify API origin):
NUXT_API_PROXY_TARGET=http://localhost:3001
NUXT_WS_PROXY_TARGET=ws://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_DEVTOOLS=false
