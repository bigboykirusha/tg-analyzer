NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Storage
DATABASE_URL=postgresql://postgres:password@localhost:5432/tganalyzer
REDIS_URL=redis://localhost:6379

# Telegram application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Auth and session secrets. Replace before any shared environment.
JWT_SECRET=change-me-with-a-long-random-value
JWT_REFRESH_SECRET=change-me-with-another-long-random-value
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Limits and retention
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute
FULL_PARSE_COOLDOWN_HOURS=24
DATA_RETENTION_DAYS=365

# Web
NUXT_PUBLIC_API_URL=http://localhost:3001
NUXT_PUBLIC_WS_URL=ws://localhost:3001
NUXT_DEVTOOLS=false
