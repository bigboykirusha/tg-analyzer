# ------------------------------------------------------------------
# TG-ANALYZER .env.example
# Выберите ОДИН блок в зависимости от того, ГДЕ РАЗВЕРЧИВАЕТЕСЬ:
#   - A) Локальная разработка (localhost)
#   - B) PRODUCTION: Vercel (Web) + Railway/Render (API + Worker) = cross-origin
#   - C) PRODUCTION: All-in-one (Web + API на одном домене, Nuxt Proxy)
# ------------------------------------------------------------------

# ==============================================================
# ОБЩИЕ ПЕРЕМЕННЫЕ (нужны ВСЕГДА)
# ==============================================================

# Storage (Neon Postgres + Upstash Redis recommended for PROD)
DATABASE_URL=
REDIS_URL=

# Telegram app credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Auth & session — замените на свои длинные рандомные значения!
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_ENCRYPTION_KEY=

# Rate limits & data retention
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute
FULL_PARSE_COOLDOWN_HOURS=24
DATA_RETENTION_DAYS=365

NODE_OPTIONS=--max-old-space-size=2048

# ==============================================================
# ВАРИАНТ А) ЛОКАЛЬНАЯ РАЗРАБОТКА (pnpm dev)
# Nuxt (3000) + Fastify API (3001) + BullMQ Worker
# API/WS идут через Nuxt Nitro proxy (без CORS-костылей)
# ==============================================================
NODE_ENV=development

# --- API (Fastify) ---
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- WEB (Nuxt) ---
NUXT_DEVTOOLS=false
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Оставляем API URL ПУСТЫМИ = включаем Nuxt Nitro Proxy
# Браузер ходит на /api/* и /ws/* → Nuxt проксирует на localhost:3001
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_WS_URL=
NUXT_PUBLIC_WS_DIRECT_URL=
# Куда Nuxt должен проксировать (адрес реального Fastify API)
NUXT_API_PROXY_TARGET=http://localhost:3001
NUXT_WS_PROXY_TARGET=ws://localhost:3001

# ==============================================================
# ВАРИАНТ Б) PRODUCTION — VERCEL (Web) + RAILWAY / RENDER (API + Worker)
# ==============================================================
# РАСКОММЕНТИРУЙТЕ БЛОК НИЖЕ на проде и подставьте свои URL:
#
# NODE_ENV=production
#
# # --- PROD: API (Railway / Render Web Service) --------------
# # API_HOST=0.0.0.0
# # CORS_ORIGIN=https://your-web-site.vercel.app            ← ОБЯЗАТЕЛЬНО = Vercel домен
# # COOKIE_SECURE=true                                      ← обязателен при HTTPS
# # COOKIE_SAME_SITE=lax                                    ← HTTP идет через same-origin Nuxt proxy
# #   (Если у вас свой домен 2-го уровня: app.example.com + api.example.com → lax можно)
# # COOKIE_DOMAIN=
#
# # --- PROD: WEB (Vercel) -----------------------------------
# # NUXT_PUBLIC_SITE_URL=https://your-web-site.vercel.app
# # HTTP оставляем same-origin через Nitro proxy; WebSocket подключаем напрямую
# # NUXT_PUBLIC_API_URL=
# # NUXT_PUBLIC_WS_URL=wss://tga-api-production.up.railway.app
# # NUXT_PUBLIC_WS_DIRECT_URL=wss://tga-api-production.up.railway.app
# # NUXT_API_PROXY_TARGET=https://tga-api-production.up.railway.app
# # NUXT_WS_PROXY_TARGET=wss://tga-api-production.up.railway.app

# ==============================================================
# ВАРИАНТ В) PRODUCTION — All-in-one Render / Coolify: Web + API на одном домене
# (Nuxt на 80/443, /api/* проксируется на Fastify)
# ==============================================================
# NODE_ENV=production
#
# CORS_ORIGIN=https://app.example.com
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
#
# NUXT_PUBLIC_SITE_URL=https://app.example.com
# # ПУСТЫЕ URL = используем Nuxt Nitro proxy → нет CORS проблем
# NUXT_PUBLIC_API_URL=
# NUXT_PUBLIC_WS_URL=
# NUXT_PUBLIC_WS_DIRECT_URL=
# # Реальный адрес Fastify API (внутренний в приватной сети):
# NUXT_API_PROXY_TARGET=http://tga-api:10000
# NUXT_WS_PROXY_TARGET=ws://tga-api:10000
