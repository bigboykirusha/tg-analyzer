# TG Analyzer — environment. Copy to .env for local development.
# Full reference: docs/ENVIRONMENT.md

NODE_ENV=development
LOG_LEVEL=info

# --- Storage -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/tganalyzer
REDIS_URL=redis://127.0.0.1:6379/0

# --- Telegram ------------------------------------------------------------
# fake: built-in demo account, no Telegram needed (login code 12345). Not allowed in production.
# live: real Telegram; requires credentials from https://my.telegram.org
TELEGRAM_MODE=fake
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Secrets (generate: openssl rand -hex 32) ----------------------------
SESSION_ENCRYPTION_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Exact web origin(s), comma separated.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Defaults to true in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW=1 minute
CHAT_REPARSE_COOLDOWN_MINUTES=60
DATA_RETENTION_DAYS=365
# Free plan: analyses per user in 24 hours (default 3). 0 turns the limit off.
FREE_ANALYSES_PER_DAY=3
# Our own bot for «the report is ready» (@BotFather). Leave empty to turn it off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public web address for links in bot messages; defaults to the first CORS_ORIGIN.
APP_URL=

# --- Web -----------------------------------------------------------------
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the web server proxies /api (runtime).
NUXT_API_PROXY_TARGET=http://127.0.0.1:3001
# Direct WebSocket endpoint of the API (build time; defaults to the proxy target in dev).
NUXT_PUBLIC_WS_URL=
