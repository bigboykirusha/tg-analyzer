{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack pnpm install --frozen-lockfile && corepack pnpm --filter @tg-analyzer/api build",
    "watchPatterns": ["apps/api/**", "packages/shared/**", "pnpm-lock.yaml", "package.json", "railway.json"]
  },
  "deploy": {
    "preDeployCommand": ["corepack pnpm --filter @tg-analyzer/api migrate"],
    "startCommand": "node scripts/start-from-env.mjs",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
