{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack pnpm install && corepack pnpm -r build",
    "nixpacks": {
      "infrastructure": {
        "nix": {
          "packageVersioning": "devshell-flake"
        }
      }
    },
    "watchPatterns": [
      "apps/api/**",
      "apps/web/**",
      "packages/**",
      "pnpm-lock.yaml",
      "package.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "echo 'MULTI-SERVICE MONOREPO: set per-service override in Railway: use $RAILWAY_SERVICE_NAME == api for corepack pnpm --filter @tg-analyzer/api start, or set explicit --service flag per deploy.'"
  },
  "services": {
    "$service-api": {
      "name": "tga-api",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "corepack pnpm install && corepack pnpm --filter @tg-analyzer/shared build && corepack pnpm --filter @tg-analyzer/api build"
      },
      "deploy": {
        "startCommand": "corepack pnpm --filter @tg-analyzer/api start",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "$service-web": {
      "name": "tga-web",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "corepack pnpm install && corepack pnpm --filter @tg-analyzer/shared build && corepack pnpm --filter @tg-analyzer/web build"
      },
      "deploy": {
        "startCommand": "corepack pnpm --filter @tg-analyzer/web start",
        "healthcheckPath": "/",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "$service-worker": {
      "name": "tga-worker",
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "corepack pnpm install && corepack pnpm --filter @tg-analyzer/shared build && corepack pnpm --filter @tg-analyzer/api build"
      },
      "deploy": {
        "startCommand": "corepack pnpm --filter @tg-analyzer/api worker",
        "restartPolicyType": "ON_FAILURE",
        "healthcheckPath": "",
        "healthcheckTimeout": 0
      }
    }
  }
}
