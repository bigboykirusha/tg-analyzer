{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack pnpm install --frozen-lockfile && node scripts/service.mjs build"
  },
  "deploy": {
    "preDeployCommand": ["node scripts/service.mjs migrate"],
    "startCommand": "node scripts/service.mjs start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
