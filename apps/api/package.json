{
  "name": "@tg-analyzer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "tsup src/index.ts src/workers/index.ts --format esm --out-dir dist --clean --external telegram --external dotenv --external pg --external ioredis --external bullmq --external drizzle-orm --external fastify --external @fastify/cookie --external @fastify/cors --external @fastify/jwt --external @fastify/rate-limit --external @fastify/websocket --external jsonwebtoken --external zod",
    "check": "tsc --project tsconfig.json --noEmit",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "start": "node --experimental-specifier-resolution=node dist/index.js",
    "worker": "node --experimental-specifier-resolution=node dist/workers/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@tg-analyzer/shared": "workspace:*",
    "bullmq": "^5.56.5",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "telegram": "^2.26.22",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
